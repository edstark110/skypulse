# SkyPulse · .gitignore
# Military-grade ignore — no clutter, no leaks

# Backups (kept locally; rolled back versions)
*.broken-backup.html
*.STABLE-backup.html
*.bak
*.backup
*~

# Node
node_modules/
npm-debug.log*
# package-lock.json is COMMITTED so Vercel reproduces exact installs

# Vercel artifacts
.vercel/
.env
.env.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Claude Code workspace config (user-local)
.claude/

# Logs
*.log
logs/

# Build artifacts (data generators)
_*.json
_*.js

# Build output (n/a but reserved)
dist/
build/
out/

.vercel
